"""skelgraph — hermetic Python build under bzlmod.

Python-only project: rules_python provides a hermetic interpreter (no system
Python required) and rules_uv drives the requirements.in -> requirements.lock
lockfile. Third-party imports resolve through the @pypi hub (e.g. @pypi//numpy).
"""

module(
    name = "skelgraph",
    version = "0.1.0",
    compatibility_level = 1,
)

# --- Core rule sets (pin every one; bump intentionally) ---------------------
bazel_dep(name = "rules_python", version = "2.0.3")
bazel_dep(name = "rules_uv", version = "0.86.0")

PYTHON_VERSION = "3.11"

# --- Hermetic Python toolchain ----------------------------------------------
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

# --- pip: resolve the single root lockfile into the @pypi hub ---------------
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = PYTHON_VERSION,
    requirements_lock = "//:requirements.lock",
)
use_repo(pip, "pypi")
